# GEMINI_API_KEY: Optional server-side key for AI Daily Global Briefing (/api/briefing)
# and Career AI Assist (/api/careers/ai-assist). Keep server-side only (never VITE_*).
GEMINI_API_KEY=

# APP_URL: Deployed public URL (e.g. https://trendverse-ten.vercel.app)
APP_URL=

# ALLOWED_ORIGINS: Optional comma-separated origins permitted for cross-origin API calls
# when deploying frontend and backend separately (e.g. https://trendverse-ten.vercel.app)
ALLOWED_ORIGINS=

# VITE_API_BASE_URL: Leave empty for unified Vercel / AI Studio deployment (uses same-origin /api/*).
# Only set if hosting a separate Express API server (never use localhost in production).
VITE_API_BASE_URL=
