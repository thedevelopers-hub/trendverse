# GEMINI_API_KEY: Optional server-side key for AI Daily Global Briefing (/api/briefing)
# and Career AI Assist (/api/careers/ai-assist). Keep server-side only (never VITE_*).
GEMINI_API_KEY=

# APP_URL / VITE_SITE_URL: Canonical production URL (e.g. https://trendverse-ten.vercel.app)
APP_URL=https://trendverse-ten.vercel.app
VITE_SITE_URL=https://trendverse-ten.vercel.app

# ALLOWED_ORIGINS: Optional comma-separated origins permitted for cross-origin API calls
# when deploying frontend and backend separately (e.g. https://trendverse-ten.vercel.app)
ALLOWED_ORIGINS=

# VITE_API_BASE_URL: Leave empty for unified Vercel / AI Studio deployment (uses same-origin /api/*).
# Only set if hosting a separate Express API server (never use localhost in production).
VITE_API_BASE_URL=

# Search Engine Verification Tokens (Optional — public meta tag tokens)
VITE_GSC_VERIFICATION=
VITE_BING_VERIFICATION=

# Google Analytics 4 (Optional — consent-gated client measurement ID, e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Google AdSense Configuration (Optional — set only after Google AdSense approves your site)
# Do NOT insert placeholder or fake publisher IDs.
ADSENSE_PUBLISHER_ID=
VITE_ADSENSE_PUBLISHER_ID=
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_RECTANGLE=
VITE_ADSENSE_SLOT_IN_ARTICLE=
